<Window x:Class="RumiCar.DriveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RumiCar.DriveManager"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="RumiCar 走行管理" Height="860" Width="1180" MinHeight="700" MinWidth="980"
        Background="{StaticResource Brush.Window}"
        TextElement.Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Header: title, connection, emergency stop -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="RumiCar 走行管理" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionState}" FontSize="12" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="車両" Style="{StaticResource Text.Label}"/>
                <TextBox Width="130" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotConnected}"/>
                <TextBlock Text="名前" Style="{StaticResource Text.Label}" Margin="14,0,12,0"/>
                <TextBox Width="110" Text="{Binding CarName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotConnected}"/>
                <Button x:Name="ConnectButton" Content="接続" Style="{StaticResource Button.Primary}" MinWidth="88" Margin="14,0,0,0" Click="OnConnectClick"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="非常停止" Style="{StaticResource Button.Danger}" MinWidth="100" Click="OnEStopClick" IsEnabled="{Binding Connected}"/>
                <Button Content="非常停止解除" MinWidth="110" Margin="8,0,0,0" Click="OnEStopClearClick" IsEnabled="{Binding Connected}"/>
            </StackPanel>
        </Grid>

        <!-- Camera -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ImageBorder" Grid.Row="0" Background="{StaticResource Brush.ImageBackground}" CornerRadius="8,8,0,0"
                        Focusable="True" MouseLeftButtonDown="OnImageClick">
                    <Grid>
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="8" Visibility="{Binding ImageVisibility}"/>
                        <TextBlock Text="画像の表示はオフです（受信と収録は続いています）" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ImageHiddenNoteVisibility}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="受信コマ数" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding Frames}" Style="{StaticResource Text.Value}"/>
                        <TextBlock Text="画像付き" Style="{StaticResource Text.Label}" Margin="16,0,12,0"/>
                        <TextBlock Text="{Binding Images}" Style="{StaticResource Text.Value}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="画像を表示" IsChecked="{Binding ShowImage}" ToolTip="オフにすると表示だけ止めます。受信と収録には影響しません"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right column: status, driving, recording, versions -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="状態" Style="{StaticResource Text.Section}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding Mode}" FontSize="12" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EStop}" Value="なし">
                                                <Setter Property="Background" Value="{StaticResource Brush.OkSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EStop}" Value="なし">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="非常停止: "/><Run Text="{Binding EStop}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="判断状態" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LogicState}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ToF 左 / 中 / 右 [mm]" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tof}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="モーター出力" Style="{StaticResource Text.Label}" ToolTip="実際にモーターへ出した指令。駆動の % は PWM のデューティ比（1000‰ = 100%）、括弧内は Arduino の analogWrite 換算（0〜255）"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Command}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ロジックの判断" Style="{StaticResource Text.Label}" ToolTip="ロジックがそのコマで決めた指令（手動・収録のみ・非常停止中でも表示）"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogicCommand}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="版（ロジック / データ）" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Versions}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="判断データ" Style="{StaticResource Text.Label}" ToolTip="使用中の判断データ（パック）の名前・版と、manifest に書かれた説明"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PackInfo}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="対応機能" Style="{StaticResource Text.Label}" ToolTip="判断データが扱える場面（壁 / 信号機 / 車両 / 交差点）"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PackCapabilities}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="学習元" Style="{StaticResource Text.Label}" ToolTip="判断データを作るのに使った収録シナリオ"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PackScenarios}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="電源" Style="{StaticResource Text.Label}" ToolTip="車のファームウェアが報告する低電圧・処理速度制限の状態"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Power}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="バッテリー" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Battery}" Style="{StaticResource Text.Value}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="走行" Style="{StaticResource Text.Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="自動" Tag="auto" Style="{StaticResource Button.Mode}" Click="OnModeAutoClick" IsEnabled="{Binding Connected}"/>
                            <Button Content="手動" Tag="manual" Style="{StaticResource Button.Mode}" Margin="6,0,0,0" Click="OnModeManualClick" IsEnabled="{Binding Connected}"/>
                            <Button Content="収録のみ" Tag="record_only" Style="{StaticResource Button.Mode}" Margin="6,0,0,0" Click="OnModeRecordOnlyClick" IsEnabled="{Binding Connected}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                                   Text="手動：矢印キー（↑ 前進 ↓ 後退 ← → 操舵）。手動モードで画像をクリックしてから操作します。"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                            <Run Text="起動時のモード: "/><Run Text="{Binding StartupMode}"/><Run Text="（収録のみ = 電源を入れても走らず、「自動」を押すと走り出します）"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="収録" Style="{StaticResource Text.Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="保存先フォルダ"/>
                            <Button x:Name="RecordButton" Grid.Column="1" Content="収録開始" Style="{StaticResource Button.Primary}" MinWidth="96" Margin="8,0,0,0"
                                    Click="OnRecordClick" IsEnabled="{Binding Connected}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="シナリオ" Style="{StaticResource Text.Label}"
                                       ToolTip="この収録が何の場面か（例：壁のみの走行データ、信号機ありケース1）。session.json に書かれ、判断データの学習元として使います"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding ScenarioHistory}"
                                      Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                      ToolTip="入力するか、使ったことのある名前を選びます。収録開始時の値が記録されます"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="メモ" Style="{StaticResource Text.Label}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="自由記述（任意）。session.json に書かれます"/>
                        </Grid>
                        <CheckBox Content="接続したら自動で収録を開始する" IsChecked="{Binding AutoRecord}" Margin="0,8,0,0"
                                  ToolTip="オン（既定）：接続のたびに新しい収録フォルダを作り、受信した全コマを保存します。切断で収録を閉じます"/>
                        <TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoButton" Grid.Column="0" Content="動画を作る…" MinWidth="110" Click="OnVideoClick"
                                    ToolTip="収録フォルダを選び、その画像から動画（video.avi、Motion JPEG、実時間）を作ります。接続していなくても使えます"/>
                            <TextBlock Grid.Column="1" Text="{Binding VideoStatus}" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="版の管理（ロジック / データ）" Style="{StaticResource Text.Section}"/>
                        <ListBox x:Name="VersionList" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Display" Height="140"/>
                        <TextBlock Text="{Binding SelectedVersion.Details}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="一覧更新" Click="OnVersionsRefreshClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="送る…" Style="{StaticResource Button.Primary}" Click="OnPushClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="有効化" Click="OnActivateClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="削除" Click="OnDeleteClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="ロジックを戻す" Click="OnRollbackLogicClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="データを戻す" Click="OnRollbackPackClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PushStatus}" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Log -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ログ" Style="{StaticResource Text.Section}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Log}" BorderThickness="0" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
