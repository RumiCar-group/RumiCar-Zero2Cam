<Window x:Class="RumiCar.DriveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RumiCar.DriveManager"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="RumiCar 走行管理" Height="860" Width="1180" MinHeight="700" MinWidth="980"
        Background="{StaticResource Brush.Window}"
        TextElement.Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Header: title, connection, emergency stop -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="RumiCar 走行管理" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Text.Muted}" Margin="8,0,0,2" VerticalAlignment="Bottom"
                           ToolTip="このアプリの版（Release のタグの番号）。「+g」の後ろに英数字が付くのは Release ではないビルド（その commit）"/>
                <!-- The PC's own Wi-Fi network: red when it left the car's access point while connected -->
                <Border Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{Binding PcWifiHint}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PcWifiWarning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PcWifi}" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PcWifiWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionState}" FontSize="12" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="車両" Style="{StaticResource Text.Label}"/>
                <TextBox Width="130" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotConnected}"/>
                <TextBlock Text="名前" Style="{StaticResource Text.Label}" Margin="14,0,12,0"/>
                <TextBox Width="110" Text="{Binding CarName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotConnected}"/>
                <Button x:Name="ConnectButton" Content="接続" Style="{StaticResource Button.Primary}" MinWidth="88" Margin="14,0,0,0" Click="OnConnectClick"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="非常停止" Style="{StaticResource Button.Danger}" MinWidth="100" Click="OnEStopClick" IsEnabled="{Binding Connected}"/>
                <Button Content="非常停止解除" MinWidth="110" Margin="8,0,0,0" Click="OnEStopClearClick" IsEnabled="{Binding Connected}"/>
            </StackPanel>
        </Grid>

        <!-- Camera -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="ImageBorder" Grid.Row="0" Background="{StaticResource Brush.ImageBackground}" CornerRadius="8,8,0,0"
                        Focusable="True" MouseLeftButtonDown="OnImageClick" MouseWheel="OnDriveWheel">
                    <Grid>
                        <!-- The image and the overlay share one coordinate system (image pixels) inside a Viewbox. -->
                        <Viewbox Stretch="Uniform" Margin="8" Visibility="{Binding ImageVisibility}">
                            <Grid x:Name="ImageSurface" Width="320" Height="240">
                                <Image Source="{Binding Image}" Stretch="Fill"/>
                                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="画像表示はオフ（受信と収録は継続中）" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ImageHiddenNoteVisibility}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="受信フレーム数" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="{Binding Frames}" Style="{StaticResource Text.Value}"/>
                        <TextBlock Text="画像付き" Style="{StaticResource Text.Label}" Margin="16,0,12,0"/>
                        <TextBlock Text="{Binding Images}" Style="{StaticResource Text.Value}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="判断を重ねる" IsChecked="{Binding ShowOverlay}" Margin="0,0,12,0"
                                  ToolTip="ロジックの検出結果を画像に枠で重ねて表示します（赤 = 赤信号、緑 = 青信号、水色 = 車両、橙 = 交差点。太枠 = 確定、細枠 = このフレームのみ検出）"/>
                        <CheckBox Content="画像を表示" IsChecked="{Binding ShowImage}" ToolTip="オフにすると表示のみ停止します。受信と収録には影響しません"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Right column: status, driving, recording, versions -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="状態" Style="{StaticResource Text.Section}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding Mode}" FontSize="12" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EStop}" Value="なし">
                                                <Setter Property="Background" Value="{StaticResource Brush.OkSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EStop}" Value="なし">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="非常停止: "/><Run Text="{Binding EStop}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="判断状態" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LogicState}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ToF 左 / 中 / 右 [mm]" Style="{StaticResource Text.Label}" ToolTip="RC_read の値：0〜200 = 距離 [mm]、-1 = タイムアウト（読めない）、-3 = 範囲外（20 cm 以内に何もない）"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tof}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="モーター出力" Style="{StaticResource Text.Label}" ToolTip="実際にモーターへ出力した指令を RumiCar ライブラリの呼び出しの形で表示：RC_steer(LEFT / CENTER / RIGHT) / RC_drive(FREE / REVERSE / FORWARD / BRAKE, 0〜255)。値は PWM のデューティ（255 = 100%）"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Command}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ロジックの判断" Style="{StaticResource Text.Label}" ToolTip="ロジックがそのフレームで算出した指令（手動・収録のみ・非常停止中も表示）"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogicCommand}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="版（ロジック / データ）" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Versions}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="判断データ" Style="{StaticResource Text.Label}" ToolTip="使用中の判断データ（パック）の名前・版と、manifest に書かれた説明"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PackInfo}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="対応機能" Style="{StaticResource Text.Label}" ToolTip="判断データが対応する場面（壁 / 信号機 / 車両 / 交差点）"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PackCapabilities}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="学習元" Style="{StaticResource Text.Label}" ToolTip="判断データの作成に使用した収録シナリオ"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PackScenarios}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="電源" Style="{StaticResource Text.Label}" ToolTip="車のファームウェアが報告する低電圧・処理速度制限の状態"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Power}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="バッテリー" Style="{StaticResource Text.Label}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Battery}" Style="{StaticResource Text.Value}"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="検出" Style="{StaticResource Text.Label}" ToolTip="ロジックの検出器ごとのスコア（0〜1）、位置（セルの列,行）、しきい値を超えたセル数。● = 確定"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Detections}" Style="{StaticResource Text.Value}" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="走行" Style="{StaticResource Text.Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="自動" Tag="auto" Style="{StaticResource Button.Mode}" Click="OnModeAutoClick" IsEnabled="{Binding Connected}"/>
                            <Button Content="手動" Tag="manual" Style="{StaticResource Button.Mode}" Margin="6,0,0,0" Click="OnModeManualClick" IsEnabled="{Binding Connected}"/>
                            <Button Content="収録のみ" Tag="record_only" Style="{StaticResource Button.Mode}" Margin="6,0,0,0" Click="OnModeRecordOnlyClick" IsEnabled="{Binding Connected}"/>
                        </StackPanel>

                        <!-- Manual driving pad (docs 6.2): press and drag, scroll, or the arrow keys -->
                        <Border x:Name="DrivePad" Height="190" Margin="0,10,0,0" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.CardBorder}" Background="{StaticResource Brush.LogBackground}"
                                Focusable="True" Cursor="Hand" IsEnabled="{Binding ManualEnabled}"
                                MouseDown="OnPadMouseDown" MouseMove="OnPadMouseMove" MouseUp="OnPadMouseUp"
                                LostMouseCapture="OnPadLostCapture" MouseWheel="OnDriveWheel"
                                ToolTip="押したままドラッグ：上 = 前進・下 = 後退（中心からの距離に比例）、左右の 1/3 = 操舵。離すと停止&#x0a;上下スクロール：設定速度を変更（その速度で走行を継続）　左右スクロール（2 本指で横・Shift + ホイール）：スクロール中のみ操舵&#x0a;右クリック・中クリック・Space：停止">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33.5*"/>
                                    <ColumnDefinition Width="33*"/>
                                    <ColumnDefinition Width="33.5*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Brush.AccentSoft}" Opacity="0.55" CornerRadius="7,0,0,7"/>
                                <Border Grid.Column="2" Background="{StaticResource Brush.AccentSoft}" Opacity="0.55" CornerRadius="0,7,7,0"/>
                                <Rectangle Grid.ColumnSpan="3" Height="1" Fill="{StaticResource Brush.ButtonBorder}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="前進" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <TextBlock Grid.Column="1" Text="後退" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                <TextBlock Grid.Column="0" Text="← 左" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"/>
                                <TextBlock Grid.Column="2" Text="右 →" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"/>
                                <TextBlock Grid.Column="1" Text="停止" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"/>
                                <Canvas Grid.ColumnSpan="3" IsHitTestVisible="False">
                                    <Ellipse x:Name="PadMarker" Width="18" Height="18" Fill="{StaticResource Brush.Accent}" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                                </Canvas>
                                <TextBlock Grid.ColumnSpan="3" Text="「手動」モードで操作可能" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ManualHintVisibility}" Margin="0,24,0,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ManualStatus}" Style="{StaticResource Text.Value}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大出力" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                                       ToolTip="パッドの端・スクロール・↑ ↓ キーで出力する駆動（RC_drive の値 0〜255）の上限。車の設定 max_drive_pwm でも制限されます"/>
                            <Slider Grid.Column="1" Minimum="26" Maximum="255" SmallChange="13" LargeChange="26" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ManualMaxDrive}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ManualMaxDriveText}" Style="{StaticResource Text.Value}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="停止" MinWidth="64" Margin="8,0,0,0" Click="OnManualStopClick" IsEnabled="{Binding ManualEnabled}"
                                    ToolTip="手動の指令を 0（停止・中央）にします（Space キーと同じ）。非常停止ではありません"/>
                        </Grid>
                        <CheckBox Content="左右スクロールの向きを反転" IsChecked="{Binding InvertHorizontal}" Margin="0,6,0,0"
                                  ToolTip="タッチパッドの設定により、2 本指で右へスクロールすると左へ操舵される場合にオンにします"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="手動：パッドを押したままドラッグ（離すと停止）／上下スクロールで速度、左右スクロールで操舵（画像の上でも可）／矢印キー（↑ ↓ ← →）。Space・右クリックで停止。ウィンドウが非アクティブになると停止します。"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                            <Run Text="起動時のモード: "/><Run Text="{Binding StartupMode}"/><Run Text="（収録のみ = 電源投入時は走行せず、「自動」の選択で走行を開始）"/>
                        </TextBlock>

                        <!-- Cap of the drive in auto mode (set_auto_limit) -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自動の最大出力" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                                       ToolTip="自動モードでロジックが出力する駆動（RC_drive の値 0〜255）の上限。車が保持し、本体の再起動で max_drive_pwm（既定 255）に戻ります。手動の「最大出力」とは独立しています&#x0a;自動モードへの切り替え時は、駆動の許容値を 0 から auto_accel_pwm_per_s の傾きで増加させ、この上限で頭打ちにします（急発進しません）"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" SmallChange="13" LargeChange="26" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding AutoLimit}" IsEnabled="{Binding AutoLimitEnabled}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding AutoLimitText}" Style="{StaticResource Text.Value}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding AutoLimitNote}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="収録" Style="{StaticResource Text.Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="保存先フォルダ"/>
                            <Button x:Name="RecordButton" Grid.Column="1" Content="収録開始" Style="{StaticResource Button.Primary}" MinWidth="96" Margin="8,0,0,0"
                                    Click="OnRecordClick" IsEnabled="{Binding Connected}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="シナリオ" Style="{StaticResource Text.Label}"
                                       ToolTip="この収録が何の場面か（例：壁のみの走行データ、信号機ありケース1）。session.json に記録され、判断データの学習元として使用します"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding ScenarioHistory}"
                                      Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                      ToolTip="入力するか、使用済みの名前から選択します。収録開始時の値を記録します"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="メモ" Style="{StaticResource Text.Label}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="自由記述（任意）。session.json に記録されます"/>
                        </Grid>
                        <CheckBox Content="接続したら自動で収録を開始する" IsChecked="{Binding AutoRecord}" Margin="0,8,0,0"
                                  ToolTip="オン（既定）：接続のたびに新しい収録フォルダを作成し、受信した全フレームを保存します。切断で収録を終了します"/>
                        <TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoButton" Grid.Column="0" Content="動画を作る…" MinWidth="110" Click="OnVideoClick"
                                    ToolTip="収録フォルダを選択し、その画像から動画（video.avi、Motion JPEG、実時間）を作成します。未接続でも使用可"/>
                            <TextBlock Grid.Column="1" Text="{Binding VideoStatus}" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="版の管理（ロジック / データ）" Style="{StaticResource Text.Section}"/>
                        <ListBox x:Name="VersionList" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Display" Height="140"/>
                        <TextBlock Text="{Binding SelectedVersion.Details}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="一覧更新" Click="OnVersionsRefreshClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="送る…" Style="{StaticResource Button.Primary}" Click="OnPushClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"
                                    ToolTip="manifest.json を含むロジック／データのフォルダを送信します（学習したパックなど）"/>
                            <Button Content="自分のプログラムを送る…" Style="{StaticResource Button.Primary}" Click="OnPushProgramClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"
                                    ToolTip="drive.py（と params.json）を含むフォルダを選択すると、車に送信して有効化します。manifest は自動で作成します。見本は README 11 章「自作の走行プログラム（Python）」"/>
                            <Button Content="有効化" Click="OnActivateClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="削除" Click="OnDeleteClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="ロジックを戻す" Click="OnRollbackLogicClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                            <Button Content="データを戻す" Click="OnRollbackPackClick" IsEnabled="{Binding Connected}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PushStatus}" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="SD カード（車の本体の更新）" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding SdCardStatus}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="SD カードを作る…" Style="{StaticResource Button.Primary}" MinWidth="140" Click="OnSdCardClick" Margin="0,0,6,6"
                                    ToolTip="Release のイメージをこの PC にダウンロードして検証し、Raspberry Pi Imager で SD カードに書き込みます（新規作成・本体の更新）。未接続でも使用可"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Log -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ログ" Style="{StaticResource Text.Section}" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Log}" BorderThickness="0" Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
