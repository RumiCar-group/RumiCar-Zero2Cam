<Window x:Class="RumiCar.DriveManager.SdCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SD カードの作成（車の本体の更新）" Height="700" Width="760" MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}"
        TextElement.Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="版" Style="{StaticResource Text.Section}"/>
                    <TextBlock x:Name="VersionsText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Release の一覧（GitHub。インターネット接続が必要です。車のアクセスポイントに接続している間は取得できません）" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <ListBox x:Name="ReleaseList" Height="120" DisplayMemberPath="Display" SelectionChanged="OnReleaseSelected"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FetchButton" Grid.Column="0" Content="一覧を取得" MinWidth="96" Click="OnFetchClick"/>
                        <TextBlock x:Name="FetchStatus" Grid.Column="1" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="作成" Style="{StaticResource Text.Section}"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="選択した版のイメージをこの PC にダウンロードして SHA-256 で検証し、Raspberry Pi Imager を開きます。Imager でデバイス「Raspberry Pi Zero 2 W」→ OS「RumiCar Zero2Cam ＜版＞」→ ストレージ（SD カード）を選んで書き込みます。書き込みと書き込み後の検証は Imager が行い、管理者権限は Imager が求めます。"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="保存先" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="FolderText" Grid.Column="1" IsReadOnly="True" Margin="8,0,8,0"/>
                        <Button Grid.Column="2" Content="フォルダを開く" Click="OnOpenFolderClick"/>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="CreateButton" Content="ダウンロードして Imager で書き込む" Style="{StaticResource Button.Primary}" MinWidth="240" Click="OnCreateClick" IsEnabled="False"/>
                        <Button x:Name="CancelButton" Content="中止" MinWidth="72" Margin="8,0,0,0" Click="OnCancelClick" IsEnabled="False"/>
                        <Button x:Name="ImagerButton" Content="Imager を開く（ダウンロード済み）" MinWidth="200" Margin="8,0,0,0" Click="OnImagerOnlyClick" IsEnabled="False"
                                ToolTip="この PC にダウンロード・検証済みのイメージで Imager を開きます（再ダウンロードしません）"/>
                    </WrapPanel>
                    <ProgressBar x:Name="DownloadBar" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="1000" Visibility="Collapsed"/>
                    <TextBlock x:Name="CreateStatus" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ImagerText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="注意" Style="{StaticResource Text.Section}"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="・SD カードを書き直すと、車に送った判断データ・自分の走行プログラム・core.json やアクセスポイントの設定変更は消え、その版の同梱の状態に戻ります。必要なものは PC 側のフォルダから書き込み後に送り直してください（収録データは PC にあるので失われません）。"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="・Imager の OS customisation（ユーザー・Wi-Fi など）の画面は出ません。イメージに設定済みです（ユーザー rumicar / rumicar、SSH 有効、SSID RumiCar、車 10.42.0.1）。"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="・本体だけを更新する場合（SD カードを書き直さない）は、Release の .deb を ssh で入れます（README 9.2）。"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="このアプリを使わずに Imager の一覧に登録する場合の URL（Imager の App Options → Content Repository。常に最新の Release を指します）："/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManifestUrlText" Grid.Column="0" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="12"/>
                        <Button Grid.Column="1" Content="コピー" Margin="8,0,0,0" Click="OnCopyUrlClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
