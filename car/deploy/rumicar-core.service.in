[Unit]
Description=RumiCar Zero2Cam control loop
After=local-fs.target
# The car must be able to drive without any network; do not wait for it.

[Service]
Type=simple
ExecStart=@RUMICAR_BINDIR@/rumicar-core /etc/rumicar/core.json
Restart=on-failure
RestartSec=5
# Hardware access: GPIO, I2C and the PWM sysfs tree require root on a stock image.
User=root
# Keep the journal readable on a small SD card.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rumicar-core
# Stop promptly; the core brakes the motors on SIGTERM.
TimeoutStopSec=5
KillSignal=SIGTERM
# After every stop, also after a crash or a SIGKILL (when the core's own
# shutdown did not run): drive PWM off and steering lines low.  "-": a failure
# is logged but does not change the service's result.
ExecStopPost=-@RUMICAR_BINDIR@/rumicar-core --stop-motors /etc/rumicar/core.json

[Install]
WantedBy=multi-user.target
